        <mxCell id="cloud" value="Streamlit Community Cloud（公開URL）&lt;br&gt;GitHub の main から起動　／　接続情報とAPIキーは Secrets に置く" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;fillColor=#F1EFE8;strokeColor=#5F5E5A;fontColor=#5F5E5A;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="260" y="45" width="520" height="55" as="geometry" /></mxCell>
        <mxCell id="app" value="アプリ（Streamlit・Python）　app.py：サイドバーで6つの画面を切り替える" style="swimlane;fontStyle=1;startSize=26;horizontal=1;collapsible=0;html=1;whiteSpace=wrap;fillColor=#F1EFE8;strokeColor=#5F5E5A;fontColor=#5F5E5A;swimlaneFillColor=#FFFFFF;rounded=0;" vertex="1" parent="1"><mxGeometry x="40" y="140" width="1250" height="600" as="geometry" /></mxCell>
        <mxCell id="p_reg" value="文書を登録する&lt;br&gt;Wordをアップロード" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;fillColor=#E1F5EE;strokeColor=#0F6E56;fontColor=#0F6E56;fontStyle=1;" vertex="1" parent="app"><mxGeometry x="20" y="40" width="190" height="55" as="geometry" /></mxCell>
        <mxCell id="p_srch" value="人を探す&lt;br&gt;相談文から探す" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;fillColor=#EEEDFE;strokeColor=#534AB7;fontColor=#534AB7;fontStyle=1;" vertex="1" parent="app"><mxGeometry x="223" y="40" width="190" height="55" as="geometry" /></mxCell>
        <mxCell id="p_sim" value="仲間を探す&lt;br&gt;社員番号から、考えの近い人" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;fillColor=#EEEDFE;strokeColor=#534AB7;fontColor=#534AB7;fontStyle=1;" vertex="1" parent="app"><mxGeometry x="426" y="40" width="190" height="55" as="geometry" /></mxCell>
        <mxCell id="p_zoku" value="属人化マップ&lt;br&gt;替えがききにくい経験" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;fillColor=#EEEDFE;strokeColor=#534AB7;fontColor=#534AB7;fontStyle=1;" vertex="1" parent="app"><mxGeometry x="629" y="40" width="190" height="55" as="geometry" /></mxCell>
