        <mxCell id="r_word" value="word_to_rows.py&lt;br&gt;Wordを読む・入力のチェック" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;fillColor=#E1F5EE;strokeColor=#0F6E56;fontColor=#0F6E56;" vertex="1" parent="reg"><mxGeometry x="15" y="110" width="200" height="55" as="geometry" /></mxCell>
        <mxCell id="r_db" value="db.py&lt;br&gt;DBの読み書き&lt;br&gt;（doc_code で上書き）" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;fillColor=#E1F5EE;strokeColor=#0F6E56;fontColor=#0F6E56;" vertex="1" parent="reg"><mxGeometry x="15" y="180" width="200" height="55" as="geometry" /></mxCell>
        <mxCell id="r_emb" value="embed.py&lt;br&gt;章の埋め込み" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;fillColor=#E1F5EE;strokeColor=#0F6E56;fontColor=#0F6E56;" vertex="1" parent="reg"><mxGeometry x="15" y="250" width="200" height="55" as="geometry" /></mxCell>
        <mxCell id="r_note" value="登録のあと：&lt;br&gt;・関係者の看板を作り直す&lt;br&gt;・検索のキャッシュを消す&lt;br&gt;→ すぐ検索に出る" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;" vertex="1" parent="reg"><mxGeometry x="15" y="330" width="200" height="90" as="geometry" /></mxCell>
        <mxCell id="srch" value="検索・看板・マップ　search/" style="swimlane;fontStyle=1;startSize=26;horizontal=1;collapsible=0;html=1;whiteSpace=wrap;fillColor=#EEEDFE;strokeColor=#534AB7;fontColor=#534AB7;swimlaneFillColor=#FFFFFF;rounded=0;" vertex="1" parent="app"><mxGeometry x="265" y="125" width="965" height="455" as="geometry" /></mxCell>
        <mxCell id="s_h1" value="人を探す" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontStyle=1;fontColor=#534AB7;" vertex="1" parent="srch"><mxGeometry x="15" y="32" width="300" height="20" as="geometry" /></mxCell>
        <mxCell id="s_h2" value="看板・仲間を探す・もっと調べる" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontStyle=1;fontColor=#534AB7;" vertex="1" parent="srch"><mxGeometry x="330" y="32" width="300" height="20" as="geometry" /></mxCell>
        <mxCell id="s_h3" value="マップ（つながり・属人化・空白地帯）" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontStyle=1;fontColor=#534AB7;" vertex="1" parent="srch"><mxGeometry x="645" y="32" width="305" height="20" as="geometry" /></mxCell>
        <mxCell id="s_svc" value="service.py&lt;br&gt;人を探す のまとめ役" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;fillColor=#EEEDFE;strokeColor=#534AB7;fontColor=#534AB7;" vertex="1" parent="srch"><mxGeometry x="15" y="55" width="300" height="55" as="geometry" /></mxCell>
        <mxCell id="s_ret" value="retrieve.py&lt;br&gt;ベクトル検索＋全文検索（PGroonga）" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;fillColor=#EEEDFE;strokeColor=#534AB7;fontColor=#534AB7;" vertex="1" parent="srch"><mxGeometry x="15" y="125" width="300" height="55" as="geometry" /></mxCell>
        <mxCell id="s_rank" value="rank.py&lt;br&gt;RRFで統合 → 章 → 文書 → 人" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;fillColor=#EEEDFE;strokeColor=#534AB7;fontColor=#534AB7;" vertex="1" parent="srch"><mxGeometry x="15" y="195" width="300" height="55" as="geometry" /></mxCell>
        <mxCell id="s_tok" value="tokenizer.py&lt;br&gt;形態素解析（SudachiPy）" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;fillColor=#EEEDFE;strokeColor=#534AB7;fontColor=#534AB7;" vertex="1" parent="srch"><mxGeometry x="15" y="265" width="300" height="55" as="geometry" /></mxCell>
        <mxCell id="s_emb" value="embed.py&lt;br&gt;質問文の埋め込み" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;fillColor=#EEEDFE;strokeColor=#534AB7;fontColor=#534AB7;" vertex="1" parent="srch"><mxGeometry x="15" y="335" width="300" height="55" as="geometry" /></mxCell>
        <mxCell id="s_sim" value="similar.py&lt;br&gt;仲間を探す：看板のベクトルの近さ" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;fillColor=#EEEDFE;strokeColor=#534AB7;fontColor=#534AB7;" vertex="1" parent="srch"><mxGeometry x="330" y="55" width="300" height="55" as="geometry" /></mxCell>
        <mxCell id="s_brief" value="person_brief.py&lt;br&gt;もっと調べる：AIの紹介文（出典を確かめる）" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;fillColor=#EEEDFE;strokeColor=#534AB7;fontColor=#534AB7;" vertex="1" parent="srch"><mxGeometry x="330" y="125" width="300" height="55" as="geometry" /></mxCell>
        <mxCell id="s_out" value="outreach.py&lt;br&gt;相談メッセージの下書き（紹介文の経験だけ使う）" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;fillColor=#EEEDFE;strokeColor=#534AB7;fontColor=#534AB7;" vertex="1" parent="srch"><mxGeometry x="330" y="195" width="300" height="55" as="geometry" /></mxCell>
        <mxCell id="s_prof" value="profiles.py・profiles_store.py&lt;br&gt;看板を作る（ノート → 文章 → 埋め込み）" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;fillColor=#EEEDFE;strokeColor=#534AB7;fontColor=#534AB7;" vertex="1" parent="srch"><mxGeometry x="330" y="265" width="300" height="55" as="geometry" /></mxCell>
        <mxCell id="s_theme" value="themes.py　属人化・空白地帯&lt;br&gt;文書のベクトル（章の平均）&lt;br&gt;属人化：似た文書がほかの人にない文書&lt;br&gt;空白地帯：80テーマに分け、解決と未解決を数える" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;fillColor=#EEEDFE;strokeColor=#534AB7;fontColor=#534AB7;" vertex="1" parent="srch"><mxGeometry x="645" y="55" width="305" height="95" as="geometry" /></mxCell>
        <mxCell id="s_net" value="network.py　つながりマップ&lt;br&gt;看板・テーマ・文章の近さ＋組織の近さ&lt;br&gt;→ pyvis で図にする。意外なつながりも出す" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;fillColor=#EEEDFE;strokeColor=#534AB7;fontColor=#534AB7;" vertex="1" parent="srch"><mxGeometry x="645" y="165" width="305" height="95" as="geometry" /></mxCell>
        <mxCell id="s_note3" value="つながりマップは、人を探す・仲間を探す・&lt;br&gt;属人化マップの結果から開く（ポップアップ）" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;" vertex="1" parent="srch"><mxGeometry x="645" y="290" width="305" height="40" as="geometry" /></mxCell>
        <mxCell id="supa" value="Supabase（PostgreSQL）&lt;br&gt;pgvector：ベクトル&lt;br&gt;PGroonga：全文検索&lt;br&gt;&lt;br&gt;文書1,483件・章6,335件&lt;br&gt;看板767人" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=12;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FAECE7;strokeColor=#993C1D;fontColor=#993C1D;" vertex="1" parent="1"><mxGeometry x="1440" y="340" width="240" height="190" as="geometry" /></mxCell>
        <mxCell id="openai" value="OpenAI API&lt;br&gt;text-embedding-3-small：埋め込み&lt;br&gt;gpt-4o-mini：紹介文・相談メッセージ" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FAECE7;strokeColor=#993C1D;fontColor=#993C1D;" vertex="1" parent="1"><mxGeometry x="1440" y="185" width="240" height="90" as="geometry" /></mxCell>
        <mxCell id="batch" value="初期ロード　initial_load/（実行済み）&lt;br&gt;load_masters・load_documents&lt;br&gt;embed_sections・load_career_sheets&lt;br&gt;build_profiles（看板）" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;fillColor=#F1EFE8;strokeColor=#5F5E5A;fontColor=#5F5E5A;" vertex="1" parent="1"><mxGeometry x="40" y="790" width="330" height="100" as="geometry" /></mxCell>
        <mxCell id="dev" value="開発用の確認画面　_test/&lt;br&gt;rank/app.py：比重を動かして順位を見る&lt;br&gt;search_eval/：評価セット11問" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;fillColor=#F1EFE8;strokeColor=#5F5E5A;fontColor=#5F5E5A;" vertex="1" parent="1"><mxGeometry x="400" y="790" width="330" height="100" as="geometry" /></mxCell>
        <mxCell id="todo" value="未定のこと&lt;br&gt;・登録タブでアイデア投稿（IDEA-）を扱うか&lt;br&gt;・キャリアシートを画面から登録するか&lt;br&gt;・タグ・クラスタ・ログイン・関心の記録の表（未使用）&lt;br&gt;・公開URLでは誰でも登録できる。発表のあとに公開を止める" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;align=left;spacingLeft=8;fontSize=11;fillColor=#FAEEDA;strokeColor=#854F0B;fontColor=#633806;" vertex="1" parent="1"><mxGeometry x="760" y="790" width="430" height="110" as="geometry" /></mxCell>
