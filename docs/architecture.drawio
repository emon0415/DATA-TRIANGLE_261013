        <mxCell id="legend" value="緑＝登録（まよりん）／紫＝検索・看板・マップ（ほりえもん）／灰＝共通" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="760" y="6" width="600" height="24" as="geometry" /></mxCell>
