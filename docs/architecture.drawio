        <mxCell id="p_dev" value="個人看板を検索&lt;br&gt;（開発用）" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;fillColor=#EEEDFE;strokeColor=#534AB7;fontColor=#534AB7;fontStyle=1;" vertex="1" parent="app"><mxGeometry x="1035" y="40" width="190" height="55" as="geometry" /></mxCell>
        <mxCell id="reg" value="登録　register/" style="swimlane;fontStyle=1;startSize=26;horizontal=1;collapsible=0;html=1;whiteSpace=wrap;fillColor=#E1F5EE;strokeColor=#0F6E56;fontColor=#0F6E56;swimlaneFillColor=#FFFFFF;rounded=0;" vertex="1" parent="app"><mxGeometry x="20" y="125" width="230" height="455" as="geometry" /></mxCell>
