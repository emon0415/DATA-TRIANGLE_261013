        <mxCell id="e39" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeColor=#5F5E5A;fontColor=#5F5E5A;exitX=0.5;exitY=1;entryX=0.415;entryY=0;" edge="1" parent="1" source="cloud" target="app"><mxGeometry relative="1" as="geometry" /></mxCell>
